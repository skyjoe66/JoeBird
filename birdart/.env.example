# JoeBird configuration.
#
#   cp .env.example state/joebird.env
#   chmod 600 state/joebird.env      # it will hold your API key
#   $EDITOR state/joebird.env
#
# The systemd units read this file via EnvironmentFile, so it is plain
# KEY=value with no shell quoting, no export, and no comments after a value.
#
# Everything except OPENAI_API_KEY has a working default. Uncomment only what
# you actually want to change - the defaults below are what the code uses.


# ---------------------------------------------------------------- credentials

# Required. Never commit this file once filled.
OPENAI_API_KEY=sk-your-key-here


# ---------------------------------------------------------------- where things are

# Your Fugleramme checkout. Artwork is installed under its assets/artwork/.
#FUGLERAMME_DIR=/path/to/fugleramme      # default: the checkout this package sits in

# This project's own directory, holding state/ and work/.
#BIRDART_DIR=/path/to/fugleramme/birdart  # default: beside this package

# BirdNET-Go's API - the source of truth for what has been heard.
#BIRDART_DETECTOR=http://127.0.0.1:8090

# The Fugleramme frame the overlay sits in front of.
#BIRDART_FRAME=http://127.0.0.1:8080

# Port the overlay listens on. Apache sends /state and /collage.png here.
#BIRDART_OVERLAY_PORT=8081


# ---------------------------------------------------------------- what to build, and where

# The shared library: a public GitHub repository of plates other frames have
# already generated, tried before spending a token. Empty disables it. Any
# repository with the same layout (index.json + birds/) works here.
#BIRDART_LIBRARY=https://raw.githubusercontent.com/skyjoe66/joebird-library/main

# Seconds to trust a cached copy of the library's index.
#BIRDART_LIBRARY_TTL=3600

# Folder under the frame's assets/artwork/ to install into. This fork keeps
# exactly one, so there is nothing to match up.
#BIRDART_STYLE=library


# ---------------------------------------------------------------- pacing

# Seconds between checks for newly heard species. Lower reacts faster and
# queries the detector more often.
#BIRDART_POLL=20

# Failures before a species is parked and stopped being retried.
#BIRDART_MAX_ATTEMPTS=3

# Generations to attempt for one species before giving up. Each one costs money.
#BIRDART_GENERATE_ATTEMPTS=2


# ---------------------------------------------------------------- image generation
#
# All of these, and the API keys, are normally set on the frame's admin page
# (System -> AI images), which writes state/settings.json. That file wins over
# anything here; these are the fallbacks for an install that never opens it.

# openai (gpt-image-2) or gemini (Imagen, experimental)
#BIRDART_PROVIDER=openai
#BIRDART_IMAGE_MODEL=gpt-image-2               # https://platform.openai.com/docs/models
#BIRDART_GEMINI_MODEL=imagen-4.0-generate-001   # https://ai.google.dev/gemini-api/docs/models
#BIRDART_IMAGE_QUALITY=high          # low | medium | high - high is what makes both legs turn up
#BIRDART_EXTRA_PROMPT=              # appended to the plate prompt verbatim
#GEMINI_API_KEY=

# Seconds to allow one `claude -p` call, which verifies plates and inspects
# finished cut-outs.
#BIRDART_CLAUDE_TIMEOUT=300


# ---------------------------------------------------------------- image generation

#BIRDART_IMAGE_MODEL=gpt-image-2
#BIRDART_IMAGE_SIZE=1024x1536
#BIRDART_IMAGE_QUALITY=medium

# Background to ask for:
#   transparent  no background at all - the cut-out is exact, and this is the
#                only setting that reliably keeps a pale-faced bird intact
#   flat         a plain untextured ivory background, removed by colour
#   paper        the prompt's own aged-paper look; hardest to cut cleanly
#BIRDART_IMAGE_BACKGROUND=transparent


# ---------------------------------------------------------------- appearance

# Halo width in pixels behind each cut-out, matching Fugleramme's paper so the
# bird sits on the page rather than looking like a sticker.
#BIRDART_HALO_PX=18
