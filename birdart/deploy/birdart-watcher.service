# Copy to /etc/systemd/system/, then replace every /PATH/TO/fugleramme with
# your checkout and User= with the account that owns it. The bot runs from the
# birdart/ directory of the frame it feeds; its defaults find the frame from
# there, so nothing else needs pointing anywhere.
[Unit]
Description=birdart watcher (draws a plate for any species BirdNET-Go hears that the frame cannot draw)
After=network-online.target docker.service fugleramme-frame.service
Wants=network-online.target

[Service]
Type=simple
User=USER
WorkingDirectory=/PATH/TO/fugleramme/birdart
Environment=PATH=/PATH/TO/home/.local/bin:/usr/local/bin:/usr/bin:/bin
# The shared library is tried first, then generation with your own OpenAI
# key, into the fork's single library/. See ../.env.example for the settings.
Environment=BIRDART_POLL=8
# The API key lives in a file so it never appears in `systemctl cat` or `ps`.
# "-" means the unit still starts if a file is absent; generation then fails
# with a clear message instead of the service refusing to run.
EnvironmentFile=-/PATH/TO/fugleramme/birdart/state/joebird.env
EnvironmentFile=-/PATH/TO/fugleramme/birdart/state/openai.env
ExecStart=/PATH/TO/home/.local/bin/uv run python -m birdart.watcher
SuccessExitStatus=143 SIGTERM
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
