# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.venv-rembg/
venv/

# Artwork pipeline: scraping, background removal, curation into a style, and the
# scans and cut-outs they work on. All of it runs on the workstation only, never
# on the Pi, and nothing the frame runs depends on it - so it stays local.
scripts/
wikimedia-scrape/
rawpixel-scrape/

# Runtime artifacts: BirdNET-Go's DB (detector/data) and the frame's rendered output
data/
*.db
*.db-wal
*.db-shm
frame.png

# Per-Pi detector config and BirdNET-Go's runtime state. Only the template is
# tracked - the rest is machine-specific, and the config (and any backup of it)
# carries the web session secret and whatever passwords are configured, so it
# must never be committed.
detector/config/*
!detector/config/config.yaml.template

# Per-Pi container env (UID/GID/ALSA card), written by run.sh
detector/.env

# Per-Pi install choices (ports, where BirdNET-Go runs), written by install.sh
frame.env

# Built docs site
site/
